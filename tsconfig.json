{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "typeRoots": ["vendor/claude-code-types", "node_modules/@types"],
    "types": ["claude-code", "claude-code-tools", "node"]
  },
  "include": [".claude/skills/live-checks/harness", "ctui/hooks", "ctui/plugins", "ctui/types", "ctui/tests"]
}
